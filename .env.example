# TS24 Lead Intelligence — biến môi trường mẫu
# Sao chép thành .env và chỉnh theo môi trường

# SQLite (MVP): đường dẫn tuyệt đối
DATABASE_URL=file:/home/z/my-project/db/custom.db
# PostgreSQL (khi triển khai thật): đổi provider trong prisma/schema.prisma thành "postgresql" rồi dùng:
# DATABASE_URL=postgresql://user:password@localhost:5432/ts24

# Tùy chọn: khi đặt, mọi API ghi yêu cầu header x-api-token khớp giá trị này.
# Bỏ trống/chưa đặt = chế độ demo single-operator.
# CRM_API_TOKEN=doi-thanh-token-bi-mat
